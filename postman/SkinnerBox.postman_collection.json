{
  "info": {
    "_postman_id": "5c6018fd-0b31-480c-b3f5-5774bf57d2f8",
    "name": "SkinnerBox Auth And Trial Simulation",
    "description": "Import this collection with the matching local environment to validate login, admin approval, trial start, simulated lever presses, end-chime trial settings, counts, status, and saved results against the backend. The normal flow now uses Postman's cookie jar instead of manually storing bearer tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup And Auth",
      "description": "Use these requests in order to sign in as the validation admin, register an operator account, approve it, and sign in as the approved operator. Postman keeps the active auth session in its cookie jar automatically.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Backend health check returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Default Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Signs in as the validation admin. Postman stores the returned `skinnerbox_session` cookie automatically for later admin requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Admin login returns a user payload', function () {",
                  "  pm.expect(data.user.email).to.eql(pm.environment.get('adminEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Operator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"{{operatorDisplayName}}\",\n  \"email\": \"{{operatorEmail}}\",\n  \"password\": \"{{operatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates a pending operator account. If the account already exists, the backend may return 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Operator registration is accepted or already exists', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Users And Cache Operator Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/admin/users",
            "description": "Finds the operator account by email and stores its id as `pendingUserId` for the approval request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin users list loads', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "const operatorEmail = pm.environment.get('operatorEmail');",
                  "const operatorUser = data.users.find((user) => user.email === operatorEmail);",
                  "pm.test('Operator account exists in the users list', function () {",
                  "  pm.expect(operatorUser).to.not.equal(undefined);",
                  "});",
                  "if (operatorUser) {",
                  "  pm.environment.set('pendingUserId', operatorUser.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Operator Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/admin/users/{{pendingUserId}}/status",
            "description": "Approves the operator account so it can log in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Operator approval succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Approved Operator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{operatorEmail}}\",\n  \"password\": \"{{operatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Signs in as the approved operator. This replaces the admin cookie with the operator session, which is expected for a single Postman environment on one host."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Operator login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Operator login returns a user payload', function () {",
                  "  pm.expect(data.user.email).to.eql(pm.environment.get('operatorEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current Operator User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user request succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trial Simulation",
      "description": "These requests use the approved operator cookie session to configure a trial, start it, simulate lever presses, and inspect counts and saved results. If the backend is running on a Pi with OLED support enabled, the same flow also drives the live OLED waiting/running screens.",
      "item": [
        {
          "name": "Save Trial Configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"testName\": \"{{testName}}\",\n  \"subjectID\": {{subjectId}},\n  \"trialDuration\": {{trialDurationMinutes}},\n  \"goalForTrial\": {{goalForTrial}},\n  \"goalForTest\": {{goalForTest}},\n  \"RewaStimTime\": {{rewardDelaySeconds}},\n  \"StimTimeOn\": {{stimulusDurationSeconds}},\n  \"cooldown\": {{cooldownSeconds}},\n  \"rewardType\": \"{{rewardType}}\",\n  \"interactionType\": \"{{interactionType}}\",\n  \"stimulusType\": \"{{stimulusType}}\",\n  \"lightColor\": \"{{lightColor}}\",\n  \"endChimeEnabled\": {{endChimeEnabled}},\n  \"endChimePattern\": \"{{endChimePattern}}\",\n  \"leverPress\": 0,\n  \"nosePoke\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/test/information",
            "description": "Creates the active test configuration. The default environment is set up for a quick lever-only validation run, and it also carries the optional end-of-test chime settings used by the current backend."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trial configuration saves successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Trial",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/test/run",
            "description": "Starts the active trial that was saved in the previous request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trial starts successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate Lever Press",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/input/lever",
            "description": "Send this request repeatedly to simulate lever presses. With the default environment values, send it three times to finish the trial."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lever press simulation succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate Nose Poke",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/input/nosepoke",
            "description": "Optional helper if you want to validate a poke-based or mixed interaction sequence."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Nose poke simulation succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/counts",
            "description": "Use this after simulated presses to see the current lever and nose-poke counters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Counts request succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Test Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/test/status",
            "description": "Once the valid interaction goal is reached, this response should show `testFinished: true`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Test status request succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/results",
            "description": "Use this after the trial finishes to inspect the saved result row, including lever count, reward count, and end-chime metadata."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Results request succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const results = pm.response.json();",
                  "pm.test('Results include end chime fields', function () {",
                  "  pm.expect(Array.isArray(results)).to.equal(true);",
                  "  pm.expect(results.length).to.be.above(0);",
                  "  pm.expect(results[0]).to.have.property('endChimeEnabled');",
                  "  pm.expect(results[0]).to.have.property('endChimePattern');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout Operator",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    }
  ]
}
